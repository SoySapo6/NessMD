<!DOCTYPE html>
<html lang="es" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Console | MayBot</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    animation: {
                        'enter': 'enter 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards',
                    },
                    keyframes: {
                        enter: {
                            '0%': { opacity: '0', transform: 'translateY(10px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' },
                        }
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800;900&family=JetBrains+Mono:wght@400;700&display=swap');
        
        body { font-family: 'Inter', sans-serif; -webkit-font-smoothing: antialiased; }
        ::-webkit-scrollbar { width: 4px; height: 4px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #d4d4d8; border-radius: 2px; }
        .dark ::-webkit-scrollbar-thumb { background: #3f3f46; }
        .pattern-grid {
            background-image: radial-gradient(circle, currentColor 1px, transparent 1px);
            background-size: 20px 20px;
        }
    </style>
</head>
<body class="bg-gray-50 text-zinc-900 dark:bg-[#000000] dark:text-gray-100 transition-colors duration-500 overflow-hidden">

    <div class="flex h-screen w-full relative">

        <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-72 bg-white dark:bg-[#09090b] border-r border-gray-200 dark:border-zinc-800 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-out flex flex-col justify-between">
            <div class="h-24 flex items-center px-8 border-b border-gray-100 dark:border-zinc-800">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 bg-black dark:bg-white flex items-center justify-center rounded-lg">
                        <i class="fa-solid fa-terminal text-white dark:text-black text-sm"></i>
                    </div>
                    <div>
                        <h1 class="font-black text-2xl tracking-tighter leading-none">MAYBOT</h1>
                        <p class="text-[10px] font-mono font-bold text-gray-400 tracking-widest uppercase">Console v2.5</p>
                    </div>
                </div>
                <button onclick="toggleSidebar()" class="lg:hidden ml-auto"><i class="fa-solid fa-times"></i></button>
            </div>

            <nav class="flex-1 py-8 px-4 space-y-1 overflow-y-auto">
                <p class="px-4 text-[10px] font-black text-gray-400 uppercase tracking-widest mb-4">Plataforma</p>
                <button onclick="switchTab('dashboard')" id="nav-dashboard" class="group w-full flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl transition-all duration-200 hover:bg-gray-100 dark:hover:bg-zinc-800">
                    <i class="fa-solid fa-chart-pie w-5 text-gray-400 group-hover:text-black dark:group-hover:text-white transition-colors"></i>
                    Dashboard
                </button>
                <div class="space-y-1">
                    <button onclick="toggleSubbotMenu()" id="nav-subbots" class="group w-full flex items-center justify-between px-4 py-3 text-sm font-semibold rounded-xl transition-all duration-200 hover:bg-gray-100 dark:hover:bg-zinc-800">
                        <div class="flex items-center gap-3">
                            <i class="fa-solid fa-robot w-5 text-gray-400 group-hover:text-black dark:group-hover:text-white transition-colors"></i>
                            Subbots
                        </div>
                        <i id="arrow-subbot" class="fa-solid fa-chevron-down text-xs text-gray-400 transition-transform duration-300"></i>
                    </button>
                    <div id="subbot-submenu" class="hidden pl-12 pr-4 space-y-1 overflow-hidden transition-all">
                        <button onclick="switchTab('subbots')" class="w-full text-left text-xs font-medium py-2 text-gray-500 hover:text-black dark:hover:text-white transition-colors">Ver lista</button>
                        <button onclick="openLinkModal()" class="w-full text-left text-xs font-medium py-2 text-blue-600 hover:underline transition-colors">+ Nuevo Bot</button>
                    </div>
                </div>
                <button onclick="switchTab('settings')" id="nav-settings" class="group w-full flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl transition-all duration-200 hover:bg-gray-100 dark:hover:bg-zinc-800">
                    <i class="fa-solid fa-gear w-5 text-gray-400 group-hover:text-black dark:group-hover:text-white transition-colors"></i>
                    Configuración
                </button>
                <% if (user.role === 'owner' || user.role === 'admin') { %>
                    <p class="px-4 text-[10px] font-black text-gray-400 uppercase tracking-widest mt-8 mb-4">Sistema</p>
                    <button onclick="switchTab('admin')" id="nav-admin" class="group w-full flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl transition-all duration-200 hover:bg-gray-100 dark:hover:bg-zinc-800">
                        <i class="fa-solid fa-shield-halved w-5 text-gray-400 group-hover:text-black dark:group-hover:text-white transition-colors"></i>
                        Administración
                    </button>
                <% } %>
            </nav>

            <div class="p-4 border-t border-gray-100 dark:border-zinc-800">
                <div class="flex items-center gap-3 p-3 bg-gray-50 dark:bg-zinc-900 rounded-xl border border-gray-200 dark:border-zinc-800">
                    <div class="w-9 h-9 rounded-full bg-gradient-to-br from-gray-200 to-gray-300 dark:from-zinc-700 dark:to-zinc-600 flex items-center justify-center font-bold text-xs">
                        <%= user.username.charAt(0).toUpperCase() %>
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-bold truncate"><%= user.username %></p>
                        <p class="text-[10px] uppercase font-bold text-gray-400"><%= user.role %></p>
                    </div>
                    <a href="/logout" class="p-2 text-gray-400 hover:text-red-500 transition-colors"><i class="fa-solid fa-power-off"></i></a>
                </div>
            </div>
        </aside>

        <main class="flex-1 flex flex-col h-screen overflow-hidden bg-white dark:bg-black relative">
            
            <div class="lg:hidden absolute top-4 left-4 z-40">
                <button onclick="toggleSidebar()" class="p-2 bg-white dark:bg-zinc-900 rounded-lg shadow-md border border-gray-200 dark:border-zinc-800">
                    <i class="fa-solid fa-bars"></i>
                </button>
            </div>

            <div class="flex-1 overflow-y-auto p-6 lg:p-12 scroll-smooth">
                <div class="max-w-7xl mx-auto space-y-12 pb-20">

                    <section id="tab-dashboard" class="tab-content block animate-enter">
                        <header class="mb-10">
                            <h2 class="text-4xl font-black tracking-tight mb-2">Panel General</h2>
                            <p class="text-gray-500 font-medium">Vista general del rendimiento y estado de los servicios.</p>
                        </header>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 mb-10">
                            <div class="p-6 rounded-2xl bg-gray-50 dark:bg-[#09090b] border border-gray-200 dark:border-zinc-800 hover:border-black dark:hover:border-white transition-colors duration-300 group">
                                <div class="flex justify-between items-start mb-8">
                                    <div class="p-3 bg-white dark:bg-zinc-900 rounded-xl shadow-sm"><i class="fa-solid fa-memory"></i></div>
                                    <span class="text-xs font-bold bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400 px-2 py-1 rounded">ESTABLE</span>
                                </div>
                                <h3 id="ram-usage" class="text-3xl font-black font-mono tracking-tighter">--%</h3>
                                <p class="text-xs font-bold text-gray-400 uppercase mt-1">Consumo de RAM</p>
                            </div>
                            <div class="p-6 rounded-2xl bg-gray-50 dark:bg-[#09090b] border border-gray-200 dark:border-zinc-800 hover:border-black dark:hover:border-white transition-colors duration-300">
                                <div class="flex justify-between items-start mb-8">
                                    <div class="p-3 bg-white dark:bg-zinc-900 rounded-xl shadow-sm"><i class="fa-solid fa-server"></i></div>
                                </div>
                                <h3 class="text-3xl font-black font-mono tracking-tighter"><%= totalSubbots %></h3>
                                <p class="text-xs font-bold text-gray-400 uppercase mt-1">SubBots Activos</p>
                            </div>
                            <div class="p-6 rounded-2xl bg-gray-50 dark:bg-[#09090b] border border-gray-200 dark:border-zinc-800 hover:border-black dark:hover:border-white transition-colors duration-300">
                                <div class="flex justify-between items-start mb-8">
                                    <div class="p-3 bg-white dark:bg-zinc-900 rounded-xl shadow-sm"><i class="fa-solid fa-stopwatch"></i></div>
                                </div>
                                <h3 id="uptime-stats" class="text-3xl font-black font-mono tracking-tighter">0h</h3>
                                <p class="text-xs font-bold text-gray-400 uppercase mt-1">Tiempo de Actividad</p>
                            </div>
                            <button onclick="openLinkModal()" class="group p-6 rounded-2xl bg-black dark:bg-white text-white dark:text-black flex flex-col justify-between hover:shadow-2xl hover:-translate-y-1 transition-all duration-300">
                                <div class="w-10 h-10 rounded-full border-2 border-white/20 dark:border-black/20 flex items-center justify-center group-hover:bg-white group-hover:text-black dark:group-hover:bg-black dark:group-hover:text-white transition-colors">
                                    <i class="fa-solid fa-plus"></i>
                                </div>
                                <div class="text-left">
                                    <h3 class="font-black text-xl">Nuevo Bot</h3>
                                    <p class="text-xs opacity-60">Vincular dispositivo</p>
                                </div>
                            </button>
                        </div>
                    </section>

                    <section id="tab-subbots" class="tab-content hidden animate-enter">
                        <header class="flex justify-between items-end mb-10">
                            <div>
                                <h2 class="text-4xl font-black tracking-tight mb-2">Mis Subbots</h2>
                                <p class="text-gray-500 font-medium">Administra tus instancias de WhatsApp.</p>
                            </div>
                        </header>
                        <div id="bots-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
                    </section>

                    <section id="tab-settings" class="tab-content hidden animate-enter">
                        <header class="mb-10">
                            <h2 class="text-4xl font-black tracking-tight mb-2">Configuración</h2>
                            <p class="text-gray-500 font-medium">Personaliza tu experiencia.</p>
                        </header>
                        <div class="max-w-2xl space-y-6">
                            <div class="p-6 rounded-2xl border border-gray-200 dark:border-zinc-800 flex items-center justify-between">
                                <div>
                                    <h3 class="font-bold text-lg">Modo Oscuro</h3>
                                    <p class="text-sm text-gray-500">Alternar entre tema claro y oscuro.</p>
                                </div>
                                <button onclick="toggleTheme()" class="w-14 h-8 bg-gray-200 dark:bg-zinc-800 rounded-full relative transition-colors">
                                    <div class="absolute top-1 left-1 w-6 h-6 bg-white rounded-full shadow-md transform transition-transform dark:translate-x-6 flex items-center justify-center">
                                        <i class="fa-solid fa-moon text-[10px] text-black hidden dark:block"></i>
                                        <i class="fa-solid fa-sun text-[10px] text-orange-500 dark:hidden"></i>
                                    </div>
                                </button>
                            </div>
                        </div>
                    </section>

                    <section id="tab-admin" class="tab-content hidden animate-enter">
                        <header class="mb-10">
                            <h2 class="text-4xl font-black tracking-tight mb-2">Administración</h2>
                        </header>
                        <div class="border border-gray-200 dark:border-zinc-800 rounded-2xl overflow-hidden">
                            <table class="w-full text-sm text-left">
                                <thead class="bg-gray-50 dark:bg-zinc-900 border-b border-gray-200 dark:border-zinc-800 font-bold uppercase text-xs text-gray-500">
                                    <tr>
                                        <th class="p-4">Usuario</th>
                                        <th class="p-4">Rol</th>
                                        <th class="p-4">Límite</th>
                                        <th class="p-4 text-right">Acción</th>
                                    </tr>
                                </thead>
                                <tbody id="admin-user-list" class="divide-y divide-gray-100 dark:divide-zinc-800 font-mono"></tbody>
                            </table>
                        </div>
                    </section>

                </div>
            </div>
        </main>
    </div>

    <div id="link-modal" class="fixed inset-0 z-[100] hidden">
        <div class="absolute inset-0 bg-white/80 dark:bg-black/80 backdrop-blur-md transition-opacity duration-300" onclick="closeModal('link-modal')"></div>
        <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-md p-6">
            <div class="bg-white dark:bg-[#09090b] rounded-3xl shadow-2xl border border-gray-200 dark:border-zinc-800 overflow-hidden animate-enter">
                <div class="p-8">
                    <div class="flex justify-between items-center mb-6">
                        <h3 class="text-2xl font-black tracking-tight">Vincular</h3>
                        <button onclick="closeModal('link-modal')" class="w-8 h-8 rounded-full bg-gray-100 dark:bg-zinc-800 flex items-center justify-center hover:rotate-90 transition-transform"><i class="fa-solid fa-times"></i></button>
                    </div>

                    <div id="step-input" class="space-y-6">
                        <div>
                            <label class="block text-xs font-bold uppercase text-gray-400 mb-2">Número de WhatsApp</label>
                            <div class="relative">
                                <span class="absolute left-4 top-4 text-gray-400 font-bold">+</span>
                                <input type="number" id="phoneNumber" placeholder="51999999999" class="w-full pl-8 pr-4 py-4 bg-gray-50 dark:bg-zinc-900 border-2 border-transparent focus:border-black dark:focus:border-white rounded-xl outline-none font-mono font-bold transition-all">
                            </div>
                            <p class="text-[10px] text-gray-400 mt-2">Ingresa el código de país sin el símbolo +.</p>
                        </div>
                        <button onclick="requestCode()" id="btn-code" class="w-full py-4 bg-black dark:bg-white text-white dark:text-black font-bold rounded-xl hover:scale-[1.02] active:scale-[0.98] transition-all flex justify-center items-center gap-2">
                            GENERAR CÓDIGO <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>

                    <div id="step-code" class="hidden text-center space-y-6">
                        <div class="p-6 bg-gray-50 dark:bg-zinc-900 rounded-2xl border border-dashed border-gray-300 dark:border-zinc-700 relative group cursor-pointer" onclick="copyCode()">
                            <p class="text-xs font-bold text-gray-400 mb-2 uppercase">Tu código de emparejamiento</p>
                            <h2 id="pairing-code" class="text-3xl sm:text-4xl font-mono font-black tracking-widest break-all">---</h2>
                            <div class="absolute inset-0 flex items-center justify-center bg-white/10 dark:bg-black/10 opacity-0 group-hover:opacity-100 transition-opacity rounded-2xl z-10">
                                <span class="text-xs font-bold bg-black text-white px-3 py-1 rounded-full">COPIAR</span>
                            </div>
                        </div>
                        
                        <div class="flex items-center justify-center gap-3 text-sm font-medium text-gray-500 animate-pulse">
                            <i class="fa-solid fa-circle-notch fa-spin"></i>
                            <span id="connection-status">Esperando conexión...</span>
                        </div>
                        
                        <p id="timer" class="text-xs font-mono text-red-500">Expira en 60s</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="detail-modal" class="fixed inset-0 z-[100] hidden">
        <div class="absolute inset-0 bg-black/20 backdrop-blur-sm" onclick="closeModal('detail-modal')"></div>
        <div class="absolute right-0 top-0 h-full w-full max-w-md bg-white dark:bg-[#09090b] shadow-2xl border-l border-gray-200 dark:border-zinc-800 transform translate-x-full transition-transform duration-300 ease-out flex flex-col" id="detail-panel">
            <div class="p-6 border-b border-gray-100 dark:border-zinc-800 flex justify-between items-center">
                <h3 class="font-black text-xl uppercase">Configuración</h3>
                <button onclick="closeModal('detail-modal')" class="hover:rotate-90 transition-transform"><i class="fa-solid fa-times text-xl"></i></button>
            </div>
            <div class="flex-1 overflow-y-auto p-6 space-y-8">
                <div class="text-center">
                    <div class="w-20 h-20 bg-gray-100 dark:bg-zinc-900 rounded-full mx-auto flex items-center justify-center text-3xl mb-4 shadow-inner">
                        <i class="fa-solid fa-robot"></i>
                    </div>
                    <h2 id="modal-bot-name" class="text-2xl font-black">Bot Name</h2>
                    <p id="modal-bot-id" class="font-mono text-gray-500">+000000</p>
                    <span class="inline-block mt-2 px-3 py-1 bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300 text-xs font-bold rounded-full">EN LÍNEA</span>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <button onclick="botAction('restart')" class="p-4 rounded-xl border border-gray-200 dark:border-zinc-800 hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-all flex flex-col items-center gap-2">
                        <i class="fa-solid fa-rotate"></i>
                        <span class="text-xs font-bold uppercase">Reiniciar</span>
                    </button>
                    <button onclick="botAction('stop')" class="p-4 rounded-xl border border-red-200 dark:border-red-900/30 text-red-500 hover:bg-red-500 hover:text-white transition-all flex flex-col items-center gap-2">
                        <i class="fa-solid fa-power-off"></i>
                        <span class="text-xs font-bold uppercase">Apagar</span>
                    </button>
                </div>
                <form id="config-form" class="space-y-4 pt-6 border-t border-gray-100 dark:border-zinc-800">
                    <p class="text-xs font-black uppercase text-gray-400">Personalización</p>
                    <div>
                        <label class="text-xs font-bold mb-1 block">Nombre</label>
                        <input type="text" id="conf-name" class="w-full p-3 bg-gray-50 dark:bg-zinc-900 border-none rounded-xl font-bold outline-none focus:ring-2 focus:ring-black dark:focus:ring-white">
                    </div>
                    <div>
                        <label class="text-xs font-bold mb-1 block">Banner</label>
                        <input type="file" id="conf-banner" class="w-full text-xs file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-bold file:bg-black file:text-white dark:file:bg-white dark:file:text-black hover:file:opacity-80">
                    </div>
                </form>
            </div>
            <div class="p-6 border-t border-gray-100 dark:border-zinc-800 bg-gray-50 dark:bg-zinc-900">
                <button onclick="saveBotConfig()" class="w-full py-4 bg-black dark:bg-white text-white dark:text-black font-black rounded-xl hover:shadow-lg hover:-translate-y-1 transition-all">GUARDAR CAMBIOS</button>
            </div>
        </div>
    </div>

    <script>
        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }

        function toggleTheme() {
            document.documentElement.classList.toggle('dark');
            localStorage.theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
        }

        function toggleSidebar() {
            const sb = document.getElementById('sidebar');
            sb.classList.toggle('-translate-x-full');
        }

        function toggleSubbotMenu() {
            const menu = document.getElementById('subbot-submenu');
            const arrow = document.getElementById('arrow-subbot');
            menu.classList.toggle('hidden');
            arrow.classList.toggle('rotate-180');
        }

        function switchTab(tab) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.getElementById('tab-' + tab).classList.remove('hidden');
            const navs = ['dashboard', 'settings', 'admin'];
            navs.forEach(n => {
                const el = document.getElementById('nav-' + n);
                if(el) {
                    if (n === tab) el.classList.add('bg-black', 'text-white', 'dark:bg-white', 'dark:text-black');
                    else el.classList.remove('bg-black', 'text-white', 'dark:bg-white', 'dark:text-black');
                }
            });
            if(window.innerWidth < 1024) toggleSidebar();
            if(tab === 'admin') loadAdminUsers();
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
            if(id === 'detail-modal') {
                document.getElementById('detail-panel').classList.remove('translate-x-0');
                document.getElementById('detail-panel').classList.add('translate-x-full');
            }
            if(id === 'link-modal') {
                document.getElementById('step-input').classList.remove('hidden');
                document.getElementById('step-code').classList.add('hidden');
                stopWaitingForConnection();
            }
        }

        let currentBotId = null;
        let totalBotsCount = 0;
        let connectionInterval = null;

        async function loadData() {
            try {
                const r1 = await fetch('/api/system-stats');
                const stats = await r1.json();
                document.getElementById('ram-usage').innerText = stats.ram.usage;
                document.getElementById('uptime-stats').innerText = (stats.uptime / 3600).toFixed(1) + 'h';
            } catch(e) {}

            try {
                const r2 = await fetch('/api/my-subbots');
                const bots = await r2.json();
                
                if (connectionInterval && bots.length > totalBotsCount) {
                    handleSuccessfulConnection();
                }
                totalBotsCount = bots.length;

                const grid = document.getElementById('bots-grid');
                if (bots.length === 0) {
                    grid.innerHTML = `
                        <div class="col-span-full py-16 text-center border-2 border-dashed border-gray-200 dark:border-zinc-800 rounded-3xl">
                            <i class="fa-solid fa-ghost text-4xl text-gray-300 mb-4"></i>
                            <p class="text-gray-400 font-bold">No hay bots activos.</p>
                            <button onclick="openLinkModal()" class="text-sm font-bold underline mt-2">Crear uno ahora</button>
                        </div>
                    `;
                } else {
                    grid.innerHTML = bots.map((b, i) => `
                        <div onclick="openDetail('${b.id}', '${b.name}')" class="group bg-gray-50 dark:bg-[#09090b] rounded-2xl border border-gray-200 dark:border-zinc-800 overflow-hidden cursor-pointer hover:-translate-y-1 hover:shadow-xl transition-all duration-300 animate-enter" style="animation-delay: ${i * 100}ms">
                            <div class="h-32 bg-gray-200 dark:bg-zinc-900 relative overflow-hidden">
                                ${b.localConfig?.banner ? 
                                    `<img src="${b.localConfig.banner}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">` : 
                                    `<div class="w-full h-full pattern-grid text-gray-300 dark:text-zinc-800 opacity-20"></div>`
                                }
                                <div class="absolute top-3 right-3 flex gap-2">
                                    <span class="bg-green-500 text-white text-[10px] font-bold px-2 py-1 rounded-md shadow-sm">ONLINE</span>
                                </div>
                            </div>
                            <div class="p-6 relative">
                                <div class="w-14 h-14 bg-black dark:bg-white text-white dark:text-black rounded-xl absolute -top-7 left-6 flex items-center justify-center text-2xl shadow-lg border-4 border-white dark:border-black">
                                    <i class="fa-solid fa-robot"></i>
                                </div>
                                <div class="mt-6 flex justify-between items-end">
                                    <div>
                                        <h3 class="font-bold text-lg leading-tight group-hover:underline">${b.name}</h3>
                                        <p class="text-xs font-mono text-gray-500 mt-1">+${b.id}</p>
                                    </div>
                                    <div class="w-8 h-8 rounded-full bg-white dark:bg-zinc-900 flex items-center justify-center border border-gray-200 dark:border-zinc-800 group-hover:bg-black group-hover:text-white dark:group-hover:bg-white dark:group-hover:text-black transition-colors">
                                        <i class="fa-solid fa-arrow-right -rotate-45 group-hover:rotate-0 transition-transform"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `).join('') + `
                        <button onclick="openLinkModal()" class="group rounded-2xl border-2 border-dashed border-gray-200 dark:border-zinc-800 hover:border-black dark:hover:border-white transition-all flex flex-col items-center justify-center min-h-[200px] text-gray-400 hover:text-black dark:hover:text-white">
                            <i class="fa-solid fa-plus text-3xl mb-2 group-hover:scale-110 transition-transform"></i>
                            <span class="font-bold text-sm">Añadir Subbot</span>
                        </button>
                    `;
                }
            } catch(e) {}
        }

        function openLinkModal() {
            document.getElementById('link-modal').classList.remove('hidden');
        }

        async function requestCode() {
            const phone = document.getElementById('phoneNumber').value;
            if(!phone) return Swal.fire('Oops', 'Ingresa un número', 'warning');

            const btn = document.getElementById('btn-code');
            btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i>';
            btn.disabled = true;

            try {
                const res = await fetch('/request-code', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ phoneNumber: phone })
                });
                const data = await res.json();

                if(data.success) {
                    document.getElementById('step-input').classList.add('hidden');
                    document.getElementById('step-code').classList.remove('hidden');
                    document.getElementById('pairing-code').innerText = data.code;
                    startWaitingForConnection();
                    let t = 60;
                    const timerInt = setInterval(() => {
                        t--;
                        document.getElementById('timer').innerText = `Expira en ${t}s`;
                        if(t <= 0) {
                            clearInterval(timerInt);
                            closeModal('link-modal');
                            stopWaitingForConnection();
                        }
                    }, 1000);
                } else {
                    Swal.fire('Error', data.error, 'error');
                }
            } catch(e) { Swal.fire('Error', 'Fallo de red', 'error'); }

            btn.innerHTML = 'GENERAR CÓDIGO <i class="fa-solid fa-arrow-right"></i>';
            btn.disabled = false;
        }

        function copyCode() {
            const code = document.getElementById('pairing-code').innerText;
            navigator.clipboard.writeText(code);
            const Toast = Swal.mixin({toast: true, position: 'top-end', showConfirmButton: false, timer: 1500});
            Toast.fire({icon: 'success', title: 'Copiado'});
        }

        function startWaitingForConnection() {
            connectionInterval = setInterval(loadData, 2000);
        }

        function stopWaitingForConnection() {
            if(connectionInterval) {
                clearInterval(connectionInterval);
                connectionInterval = null;
            }
        }

        function handleSuccessfulConnection() {
            stopWaitingForConnection();
            closeModal('link-modal');
            Swal.fire({
                icon: 'success',
                title: '¡Conectado!',
                text: 'El SubBot se ha vinculado correctamente.',
                confirmButtonColor: '#000'
            });
        }

        function openDetail(id, name) {
            currentBotId = id;
            document.getElementById('modal-bot-name').innerText = name;
            document.getElementById('modal-bot-id').innerText = '+' + id;
            document.getElementById('conf-name').value = name;
            document.getElementById('detail-modal').classList.remove('hidden');
            setTimeout(() => {
                document.getElementById('detail-panel').classList.remove('translate-x-full');
                document.getElementById('detail-panel').classList.add('translate-x-0');
            }, 10);
        }

        async function botAction(action) {
            if(!currentBotId) return;
            await fetch('/api/subbot/action', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ id: currentBotId, action })
            });
            const Toast = Swal.mixin({toast: true, position: 'top-end', showConfirmButton: false, timer: 2000});
            Toast.fire({icon: 'success', title: 'Comando enviado'});
            loadData();
            if(action === 'stop') closeModal('detail-modal');
        }

        async function saveBotConfig() {
            const formData = new FormData();
            formData.append('botname', document.getElementById('conf-name').value);
            const file = document.getElementById('conf-banner').files[0];
            if(file) formData.append('banner', file);
            await fetch(`/api/subbot/config/${currentBotId}`, { method: 'POST', body: formData });
            const Toast = Swal.mixin({toast: true, position: 'top-end', showConfirmButton: false, timer: 2000});
            Toast.fire({icon: 'success', title: 'Guardado'});
            loadData();
            closeModal('detail-modal');
        }

        async function loadAdminUsers() {
            const res = await fetch('/api/admin/users');
            const users = await res.json();
            const tbody = document.getElementById('admin-user-list');
            tbody.innerHTML = users.map(u => `
                <tr class="hover:bg-gray-50 dark:hover:bg-zinc-900/50 transition-colors">
                    <td class="p-4 font-bold">${u.username}</td>
                    <td class="p-4"><span class="bg-gray-200 dark:bg-zinc-800 px-2 py-1 rounded text-[10px] font-black uppercase">${u.role}</span></td>
                    <td class="p-4 font-mono">${u.limit}</td>
                    <td class="p-4 text-right">
                        <button onclick="editLimit('${u.username}')" class="text-xs font-bold underline decoration-2 hover:text-blue-500">EDITAR</button>
                    </td>
                </tr>
            `).join('');
        }

        async function editLimit(username) {
            const { value } = await Swal.fire({
                title: 'Nuevo límite',
                input: 'number',
                background: document.documentElement.classList.contains('dark') ? '#09090b' : '#fff',
                color: document.documentElement.classList.contains('dark') ? '#fff' : '#000',
                confirmButtonColor: '#000'
            });
            if(value) {
                await fetch('/api/admin/users/limit', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ username, limit: value })
                });
                loadAdminUsers();
            }
        }

        switchTab('dashboard');
        loadData();
        setInterval(loadData, 8000);
    </script>
</body>
</html>
