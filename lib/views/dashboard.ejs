<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | MayBot</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; background-color: #fff; color: #000; }
        
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #fff; border-left: 1px solid #000; }
        ::-webkit-scrollbar-thumb { background: #000; }

        /* Animations */
        .slide-enter { transform: translateY(-10px); opacity: 0; }
        .slide-enter-active { transform: translateY(0); opacity: 1; transition: all 0.3s ease; }
        
        .sidebar-transition { transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .accordion-content { max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out; }
        .accordion-content.active { max-height: 1000px; }
    </style>
</head>
<body class="overflow-x-hidden flex flex-col min-h-screen">

    <!-- Navbar Mobile -->
    <nav class="border-b-2 border-black flex justify-between items-center p-4 lg:hidden sticky top-0 bg-white z-50">
        <span class="font-bold text-xl tracking-wider">MAYBOT</span>
        <button onclick="toggleSidebar()" class="focus:outline-none">
            <i class="fa-solid fa-bars text-2xl"></i>
        </button>
    </nav>

    <div class="flex flex-grow h-screen overflow-hidden">
        
        <!-- Sidebar / Hamburger Menu -->
        <aside id="sidebar" class="bg-white w-64 border-r-2 border-black flex flex-col fixed h-full z-40 transform -translate-x-full lg:translate-x-0 lg:static sidebar-transition">
            <div class="p-6 border-b-2 border-black hidden lg:block">
                <h1 class="text-2xl font-black tracking-widest text-center">MAYBOT</h1>
            </div>

            <div class="flex-grow overflow-y-auto p-4 space-y-2">
                <!-- User Info -->
                <div class="mb-6 p-4 border border-black bg-gray-50">
                    <p class="font-bold text-lg"><%= user.username %></p>
                    <p class="text-xs uppercase text-gray-500"><%= user.role %></p>
                </div>

                <!-- Menu Items -->
                <button onclick="showSection('home')" class="w-full text-left p-3 hover:bg-black hover:text-white transition-colors border border-transparent hover:border-black font-medium">
                    <i class="fa-solid fa-house w-6 text-center"></i> Inicio
                </button>

                <!-- Subbots Accordion -->
                <div>
                    <button onclick="toggleAccordion('subbots-menu')" class="w-full text-left p-3 hover:bg-black hover:text-white transition-colors border border-transparent hover:border-black font-medium flex justify-between items-center">
                        <span><i class="fa-solid fa-robot w-6 text-center"></i> Subbots</span>
                        <i class="fa-solid fa-chevron-down text-xs transition-transform" id="arrow-subbots-menu"></i>
                    </button>
                    <div id="subbots-menu" class="accordion-content pl-4 border-l-2 border-black ml-3 my-1">
                        <div id="sidebar-bot-list">
                            <!-- Dynamic List -->
                        </div>
                        <button onclick="openLinkModal()" class="w-full text-left text-sm p-2 hover:underline mt-2">
                            <i class="fa-solid fa-plus mr-1"></i> Nuevo Subbot
                        </button>
                    </div>
                </div>

                <!-- Admin Only -->
                <% if (user.role === 'owner' || user.role === 'admin') { %>
                <button onclick="showSection('admin')" class="w-full text-left p-3 hover:bg-black hover:text-white transition-colors border border-transparent hover:border-black font-medium">
                    <i class="fa-solid fa-shield-halved w-6 text-center"></i> Admin
                </button>
                <% } %>
            </div>

            <div class="p-4 border-t-2 border-black">
                <a href="/logout" class="block w-full text-center p-3 border-2 border-black font-bold hover:bg-red-600 hover:text-white hover:border-red-600 transition-colors">
                    SALIR
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 overflow-y-auto bg-white p-4 lg:p-8 relative">
            <div onclick="if(window.innerWidth < 1024) toggleSidebar()" class="lg:hidden fixed inset-0 bg-black bg-opacity-50 z-30 hidden" id="sidebar-overlay"></div>

            <!-- Home Section -->
            <section id="home-section" class="max-w-4xl mx-auto">
                <h2 class="text-3xl font-black mb-8 uppercase border-b-4 border-black inline-block pb-1">Resumen</h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                    <div class="border-2 border-black p-6 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]">
                        <p class="text-sm font-bold uppercase text-gray-500">Subbots Activos</p>
                        <p class="text-4xl font-black mt-2"><%= totalSubbots %></p>
                    </div>
                    <div class="border-2 border-black p-6 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]">
                        <p class="text-sm font-bold uppercase text-gray-500">Sistema</p>
                        <div id="sys-stats" class="mt-2 text-sm font-mono space-y-1">
                            Cargando...
                        </div>
                    </div>
                </div>

                <h3 class="text-xl font-bold mb-4 uppercase">Mis Bots</h3>
                <div id="main-bot-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Cards injected by JS -->
                </div>
            </section>

            <!-- Admin Section -->
            <section id="admin-section" class="max-w-4xl mx-auto hidden">
                <h2 class="text-3xl font-black mb-8 uppercase border-b-4 border-black inline-block pb-1">Administración</h2>
                <div class="border-2 border-black p-6 bg-white">
                    <h3 class="font-bold text-lg mb-4">Gestión de Usuarios</h3>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm">
                            <thead class="bg-black text-white uppercase">
                                <tr>
                                    <th class="p-3">Usuario</th>
                                    <th class="p-3">Rol</th>
                                    <th class="p-3">Límite</th>
                                    <th class="p-3">Acción</th>
                                </tr>
                            </thead>
                            <tbody id="admin-user-list" class="font-mono">
                                <!-- Users injected by JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <footer class="mt-12 py-6 border-t-2 border-black text-center text-sm font-medium">
                Hecho por SoyMaycol &lt;3
            </footer>
        </main>
    </div>

    <!-- Modals -->
    
    <!-- Link Modal -->
    <div id="link-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-white bg-opacity-90">
        <div class="bg-white border-2 border-black p-6 w-full max-w-md shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] relative">
            <button onclick="document.getElementById('link-modal').classList.add('hidden')" class="absolute top-2 right-4 text-2xl font-bold">&times;</button>
            <h3 class="text-xl font-bold uppercase mb-4">Nuevo Subbot</h3>
            <div class="space-y-4">
                <input type="text" id="phoneNumber" placeholder="51999999999" class="w-full p-3 border-2 border-black focus:outline-none bg-gray-50">
                <button onclick="requestCode()" id="btn-code" class="w-full bg-black text-white font-bold py-3 hover:bg-gray-800 transition-colors">OBTENER CÓDIGO</button>
                <div id="code-area" class="hidden text-center mt-4">
                    <p class="text-sm">Código de vinculación:</p>
                    <h2 id="pairing-code" class="text-4xl font-mono font-bold tracking-widest my-2 cursor-pointer" onclick="copyToClip(this.innerText)">---</h2>
                    <p class="text-xs text-red-600" id="timer"></p>
                </div>
            </div>
        </div>
    </div>

    <!-- Bot Detail Modal -->
    <div id="detail-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-white bg-opacity-90 backdrop-blur-sm">
        <div class="bg-white border-2 border-black p-0 w-full max-w-lg shadow-[10px_10px_0px_0px_rgba(0,0,0,1)] flex flex-col max-h-[90vh]">
            <div class="p-4 border-b-2 border-black flex justify-between items-center bg-gray-50">
                <h3 class="text-xl font-black uppercase" id="modal-bot-name">BOT</h3>
                <button onclick="closeDetail()" class="text-xl font-bold px-2 hover:bg-black hover:text-white transition-colors">&times;</button>
            </div>
            
            <div class="p-6 overflow-y-auto">
                <div class="flex items-center space-x-4 mb-6">
                    <div class="w-16 h-16 bg-black text-white flex items-center justify-center text-2xl border-2 border-black">
                        <i class="fa-solid fa-robot"></i>
                    </div>
                    <div>
                        <p class="font-mono text-sm" id="modal-bot-id">+00000000</p>
                        <span class="inline-block px-2 py-0.5 border border-black text-xs font-bold uppercase bg-green-100">En línea</span>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4 mb-6">
                    <button onclick="botAction('restart')" class="p-3 border-2 border-black hover:bg-black hover:text-white font-bold text-sm transition-colors text-center">
                        <i class="fa-solid fa-arrows-rotate block mb-1"></i> REINICIAR
                    </button>
                    <button onclick="botAction('stop')" class="p-3 border-2 border-black hover:bg-red-600 hover:text-white hover:border-red-600 font-bold text-sm transition-colors text-center">
                        <i class="fa-solid fa-power-off block mb-1"></i> DETENER
                    </button>
                </div>

                <form id="config-form" class="space-y-4 border-t-2 border-black pt-4">
                    <p class="font-bold uppercase text-sm">Configuración</p>
                    <div>
                        <label class="text-xs font-bold block mb-1">Nombre</label>
                        <input type="text" id="conf-name" class="w-full p-2 border-2 border-black text-sm">
                    </div>
                    <div>
                        <label class="text-xs font-bold block mb-1">Banner (Imagen)</label>
                        <input type="file" id="conf-banner" class="w-full text-sm">
                    </div>
                    <button type="button" onclick="saveBotConfig()" class="w-full bg-black text-white py-2 font-bold hover:bg-gray-800">GUARDAR CAMBIOS</button>
                </form>
            </div>
        </div>
    </div>

    <script>
        let currentBotId = null;

        // --- UI Logic ---
        function toggleSidebar() {
            const sb = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebar-overlay');
            if (sb.classList.contains('-translate-x-full')) {
                sb.classList.remove('-translate-x-full');
                overlay.classList.remove('hidden');
            } else {
                sb.classList.add('-translate-x-full');
                overlay.classList.add('hidden');
            }
        }

        function toggleAccordion(id) {
            const el = document.getElementById(id);
            const arrow = document.getElementById('arrow-' + id);
            if (el.classList.contains('active')) {
                el.classList.remove('active');
                arrow.style.transform = 'rotate(0deg)';
            } else {
                el.classList.add('active');
                arrow.style.transform = 'rotate(180deg)';
            }
        }

        function showSection(name) {
            document.getElementById('home-section').classList.add('hidden');
            document.getElementById('admin-section').classList.add('hidden');
            document.getElementById(name + '-section').classList.remove('hidden');
            if (window.innerWidth < 1024) toggleSidebar();
            if (name === 'admin') loadAdminUsers();
        }

        function openLinkModal() {
            document.getElementById('link-modal').classList.remove('hidden');
        }

        function copyToClip(text) {
            navigator.clipboard.writeText(text);
            Swal.fire({ icon: 'success', title: 'Copiado', showConfirmButton: false, timer: 1000 });
        }

        // --- API & Core Logic ---

        async function loadStats() {
            const sys = document.getElementById('sys-stats');
            const res = await fetch('/api/system-stats');
            const data = await res.json();
            sys.innerHTML = `
                RAM: ${data.ram.usage}<br>
                UPTIME: ${(data.uptime / 3600).toFixed(1)}h
            `;
        }

        async function loadBots() {
            const list = document.getElementById('sidebar-bot-list');
            const mainGrid = document.getElementById('main-bot-grid');
            
            try {
                const res = await fetch('/api/my-subbots');
                const bots = await res.json();
                
                // Sidebar List
                list.innerHTML = bots.map(b => `
                    <button onclick="openDetail('${b.id}', '${b.name}')" class="block w-full text-left text-sm py-1 hover:text-gray-600 truncate">
                        ${b.name}
                    </button>
                `).join('');

                // Main Grid
                if(bots.length === 0) {
                    mainGrid.innerHTML = `<div class="col-span-full text-center py-10 border-2 border-dashed border-gray-300">No hay bots activos</div>`;
                } else {
                    mainGrid.innerHTML = bots.map(b => `
                        <div onclick="openDetail('${b.id}', '${b.name}')" class="border-2 border-black p-4 cursor-pointer hover:bg-black hover:text-white transition-colors group">
                            <div class="flex justify-between items-center">
                                <h4 class="font-bold text-lg">${b.name}</h4>
                                <i class="fa-solid fa-arrow-right opacity-0 group-hover:opacity-100 transition-opacity"></i>
                            </div>
                            <p class="font-mono text-sm opacity-70">+${b.id}</p>
                        </div>
                    `).join('');
                }
            } catch(e) { console.error(e) }
        }

        async function requestCode() {
            const phone = document.getElementById('phoneNumber').value;
            const btn = document.getElementById('btn-code');
            
            btn.disabled = true;
            btn.innerText = 'GENERANDO...';
            
            try {
                const res = await fetch('/request-code', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ phoneNumber: phone })
                });
                const data = await res.json();
                
                if (data.success) {
                    document.getElementById('code-area').classList.remove('hidden');
                    document.getElementById('pairing-code').innerText = data.code;
                    let t = 45;
                    const timer = setInterval(() => {
                        document.getElementById('timer').innerText = `Expira en ${t}s`;
                        t--;
                        if(t < 0) { clearInterval(timer); document.getElementById('link-modal').classList.add('hidden'); }
                    }, 1000);
                } else {
                    Swal.fire('Error', data.error, 'error');
                }
            } catch(e) { Swal.fire('Error', 'Fallo de conexión', 'error'); }
            
            btn.disabled = false;
            btn.innerText = 'OBTENER CÓDIGO';
        }

        // Details & Config
        function openDetail(id, name) {
            currentBotId = id;
            document.getElementById('modal-bot-name').innerText = name;
            document.getElementById('modal-bot-id').innerText = '+' + id;
            document.getElementById('conf-name').value = name;
            document.getElementById('detail-modal').classList.remove('hidden');
        }

        function closeDetail() {
            document.getElementById('detail-modal').classList.add('hidden');
            currentBotId = null;
        }

        async function botAction(action) {
            if(!currentBotId) return;
            const res = await fetch('/api/subbot/action', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ id: currentBotId, action })
            });
            const d = await res.json();
            if(d.success) {
                Swal.fire('Éxito', 'Acción completada', 'success');
                loadBots();
                if(action === 'stop') closeDetail();
            }
        }

        async function saveBotConfig() {
            const name = document.getElementById('conf-name').value;
            const banner = document.getElementById('conf-banner').files[0];
            const formData = new FormData();
            formData.append('botname', name);
            if(banner) formData.append('banner', banner);

            const res = await fetch(`/api/subbot/config/${currentBotId}`, { method: 'POST', body: formData });
            const d = await res.json();
            if(d.success) {
                Swal.fire('Guardado', '', 'success');
                loadBots();
            }
        }

        // Admin
        async function loadAdminUsers() {
            const table = document.getElementById('admin-user-list');
            const res = await fetch('/api/admin/users');
            const users = await res.json();
            
            table.innerHTML = users.map(u => `
                <tr class="border-b border-gray-200 hover:bg-gray-50">
                    <td class="p-3">${u.username}</td>
                    <td class="p-3 uppercase text-xs">${u.role}</td>
                    <td class="p-3">${u.limit}</td>
                    <td class="p-3">
                        <button onclick="changeLimit('${u.username}')" class="text-xs font-bold border border-black px-2 py-1 hover:bg-black hover:text-white">EDITAR</button>
                    </td>
                </tr>
            `).join('');
        }

        async function changeLimit(username) {
            const { value: limit } = await Swal.fire({
                title: 'Nuevo límite',
                input: 'number',
                inputLabel: 'Cantidad máxima de bots',
                inputValue: 3,
                showCancelButton: true
            });

            if (limit) {
                await fetch('/api/admin/users/limit', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ username, limit })
                });
                loadAdminUsers();
            }
        }

        // Init
        loadStats();
        loadBots();
        setInterval(loadBots, 10000);
    </script>
</body>
</html>
