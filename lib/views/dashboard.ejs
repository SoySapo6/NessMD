<!DOCTYPE html>
<html lang="es" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Console | MayBot</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    animation: {
                        'fade-in-up': 'fadeInUp 0.5s ease-out forwards',
                        'slide-in': 'slideIn 0.3s ease-out forwards',
                    },
                    keyframes: {
                        fadeInUp: {
                            '0%': { opacity: '0', transform: 'translateY(10px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' },
                        },
                        slideIn: {
                            '0%': { transform: 'translateX(-100%)' },
                            '100%': { transform: 'translateX(0)' },
                        }
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap');
        
        /* Estilos Base & Scrollbar */
        body { font-family: 'Inter', sans-serif; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }
        
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #52525b; border-radius: 3px; }
        
        /* Glassmorphism sutil para el móvil */
        .glass-nav {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(0,0,0,0.1);
        }
        .dark .glass-nav {
            background: rgba(9, 9, 11, 0.8);
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        /* Utilidades de transición */
        .transition-all-300 { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        
        /* Checkbox Toggle para el tema */
        .toggle-checkbox:checked {
            right: 0;
            border-color: #fff;
        }
        .toggle-checkbox:checked + .toggle-label {
            background-color: #000;
        }
    </style>
</head>
<body class="bg-gray-100 text-zinc-900 dark:bg-[#09090b] dark:text-gray-100 transition-colors duration-300 antialiased overflow-hidden">

    <div class="flex h-screen w-full">

        <!-- SIDEBAR (Desktop & Mobile Drawer) -->
        <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-72 transform -translate-x-full lg:relative lg:translate-x-0 bg-white dark:bg-[#121214] border-r border-gray-200 dark:border-zinc-800 transition-transform duration-300 flex flex-col justify-between shadow-2xl lg:shadow-none">
            
            <!-- Logo Area -->
            <div class="h-20 flex items-center px-8 border-b border-gray-200 dark:border-zinc-800">
                <i class="fa-solid fa-square-full text-2xl mr-3"></i>
                <div>
                    <h1 class="font-black tracking-tighter text-2xl leading-none">MAYBOT</h1>
                    <span class="text-[10px] font-mono uppercase tracking-widest text-gray-500">Console v2.0</span>
                </div>
                <button onclick="toggleSidebar()" class="lg:hidden ml-auto text-gray-500">
                    <i class="fa-solid fa-times text-xl"></i>
                </button>
            </div>

            <!-- Navigation Links -->
            <nav class="flex-1 overflow-y-auto py-6 px-4 space-y-2">
                <p class="px-4 text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Principal</p>
                
                <button onclick="switchTab('dashboard')" id="nav-dashboard" class="nav-item w-full flex items-center px-4 py-3 text-sm font-medium rounded-lg bg-black text-white dark:bg-white dark:text-black shadow-lg transition-all group">
                    <i class="fa-solid fa-grid-2 w-6"></i>
                    Dashboard
                </button>

                <button onclick="switchTab('subbots')" id="nav-subbots" class="nav-item w-full flex items-center px-4 py-3 text-sm font-medium rounded-lg text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-zinc-800 transition-all group">
                    <i class="fa-solid fa-robot w-6"></i>
                    Mis Subbots
                    <span id="badge-count" class="ml-auto bg-gray-200 dark:bg-zinc-700 text-xs font-bold px-2 py-0.5 rounded-md">0</span>
                </button>

                <button onclick="switchTab('settings')" id="nav-settings" class="nav-item w-full flex items-center px-4 py-3 text-sm font-medium rounded-lg text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-zinc-800 transition-all group">
                    <i class="fa-solid fa-sliders w-6"></i>
                    Configuración
                </button>

                <% if (user.role === 'owner' || user.role === 'admin') { %>
                    <p class="px-4 text-xs font-bold text-gray-400 uppercase tracking-wider mt-8 mb-2">Administración</p>
                    <button onclick="switchTab('admin')" id="nav-admin" class="nav-item w-full flex items-center px-4 py-3 text-sm font-medium rounded-lg text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-zinc-800 transition-all group">
                        <i class="fa-solid fa-fingerprint w-6"></i>
                        Usuarios & Límites
                    </button>
                <% } %>
            </nav>

            <!-- User Footer -->
            <div class="p-4 border-t border-gray-200 dark:border-zinc-800">
                <div class="flex items-center gap-3 p-3 rounded-xl bg-gray-50 dark:bg-zinc-900 border border-gray-200 dark:border-zinc-700">
                    <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-gray-300 to-gray-100 dark:from-zinc-700 dark:to-zinc-600 flex items-center justify-center">
                        <i class="fa-regular fa-user text-gray-600 dark:text-gray-300"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-bold truncate"><%= user.username %></p>
                        <p class="text-xs text-gray-500 truncate capitalize"><%= user.role %></p>
                    </div>
                    <a href="/logout" class="text-gray-400 hover:text-red-500 transition-colors">
                        <i class="fa-solid fa-right-from-bracket"></i>
                    </a>
                </div>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="flex-1 flex flex-col h-screen overflow-hidden relative">
            
            <!-- Mobile Header -->
            <header class="lg:hidden h-16 glass-nav flex items-center justify-between px-6 z-40">
                <span class="font-black text-xl tracking-tighter">MAYBOT</span>
                <button onclick="toggleSidebar()" class="p-2 text-gray-600 dark:text-gray-300">
                    <i class="fa-solid fa-bars text-xl"></i>
                </button>
            </header>

            <!-- Scrollable Content Area -->
            <div class="flex-1 overflow-y-auto p-4 lg:p-10 scroll-smooth">
                <div class="max-w-7xl mx-auto space-y-8 pb-10">

                    <!-- SECCIÓN: DASHBOARD (Resumen) -->
                    <section id="tab-dashboard" class="tab-content animate-fade-in-up">
                        <div class="mb-8">
                            <h2 class="text-3xl font-bold mb-2">Bienvenido de nuevo, <%= user.username %>.</h2>
                            <p class="text-gray-500 dark:text-gray-400">Aquí tienes el resumen del estado de tus servicios hoy.</p>
                        </div>

                        <!-- Bento Grid Stats -->
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
                            <!-- Card 1 -->
                            <div class="p-6 rounded-2xl bg-white dark:bg-[#121214] border border-gray-200 dark:border-zinc-800 shadow-sm hover:shadow-md transition-all-300">
                                <div class="flex justify-between items-start mb-4">
                                    <div class="p-2 bg-black dark:bg-white text-white dark:text-black rounded-lg">
                                        <i class="fa-solid fa-microchip"></i>
                                    </div>
                                    <span class="text-xs font-mono text-green-500 bg-green-500/10 px-2 py-1 rounded">ONLINE</span>
                                </div>
                                <p class="text-sm text-gray-500 mb-1">Uso de RAM</p>
                                <h3 id="ram-usage" class="text-2xl font-bold font-mono">--%</h3>
                            </div>
                             <!-- Card 2 -->
                            <div class="p-6 rounded-2xl bg-white dark:bg-[#121214] border border-gray-200 dark:border-zinc-800 shadow-sm hover:shadow-md transition-all-300">
                                <div class="flex justify-between items-start mb-4">
                                    <div class="p-2 bg-gray-100 dark:bg-zinc-800 rounded-lg">
                                        <i class="fa-solid fa-server"></i>
                                    </div>
                                </div>
                                <p class="text-sm text-gray-500 mb-1">SubBots Globales</p>
                                <h3 class="text-2xl font-bold font-mono"><%= totalSubbots %></h3>
                            </div>
                             <!-- Card 3 -->
                            <div class="p-6 rounded-2xl bg-white dark:bg-[#121214] border border-gray-200 dark:border-zinc-800 shadow-sm hover:shadow-md transition-all-300">
                                <div class="flex justify-between items-start mb-4">
                                    <div class="p-2 bg-gray-100 dark:bg-zinc-800 rounded-lg">
                                        <i class="fa-solid fa-clock"></i>
                                    </div>
                                </div>
                                <p class="text-sm text-gray-500 mb-1">Tiempo Activo</p>
                                <h3 id="uptime-stats" class="text-2xl font-bold font-mono">0h</h3>
                            </div>
                             <!-- Card 4 (Action) -->
                            <div onclick="openLinkModal()" class="cursor-pointer group p-6 rounded-2xl bg-black text-white dark:bg-white dark:text-black shadow-lg hover:scale-[1.02] transition-all-300 flex flex-col justify-center items-center text-center border border-transparent">
                                <div class="w-12 h-12 rounded-full border-2 border-current flex items-center justify-center mb-3 group-hover:bg-white group-hover:text-black dark:group-hover:bg-black dark:group-hover:text-white transition-colors">
                                    <i class="fa-solid fa-plus text-xl"></i>
                                </div>
                                <h3 class="font-bold">Nuevo Bot</h3>
                                <p class="text-xs opacity-70 mt-1">Vincular dispositivo</p>
                            </div>
                        </div>

                        <!-- System Status Row -->
                        <div class="rounded-2xl bg-white dark:bg-[#121214] border border-gray-200 dark:border-zinc-800 p-6 md:p-8">
                            <h3 class="font-bold text-lg mb-6 flex items-center">
                                <i class="fa-solid fa-wave-square mr-2"></i> Rendimiento del Sistema
                            </h3>
                            <div class="space-y-6">
                                <div>
                                    <div class="flex justify-between text-sm mb-2 font-mono">
                                        <span>CPU Core</span>
                                        <span id="cpu-model" class="text-gray-500">Intelligent</span>
                                    </div>
                                    <div class="w-full bg-gray-100 dark:bg-zinc-800 rounded-full h-2 overflow-hidden">
                                        <div class="bg-black dark:bg-white h-2 rounded-full animate-pulse" style="width: 45%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- SECCIÓN: MIS SUBBOTS -->
                    <section id="tab-subbots" class="tab-content hidden animate-fade-in-up">
                        <div class="flex justify-between items-center mb-8">
                            <div>
                                <h2 class="text-3xl font-bold">Mis Subbots</h2>
                                <p class="text-gray-500">Gestiona tus instancias activas.</p>
                            </div>
                            <button onclick="openLinkModal()" class="hidden md:flex bg-black dark:bg-white text-white dark:text-black px-6 py-2 rounded-lg font-bold text-sm hover:opacity-80 transition-opacity items-center gap-2">
                                <i class="fa-solid fa-plus"></i> Conectar
                            </button>
                        </div>

                        <div id="bots-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            <!-- JS Injection Here -->
                        </div>
                    </section>

                    <!-- SECCIÓN: CONFIGURACIÓN -->
                    <section id="tab-settings" class="tab-content hidden animate-fade-in-up">
                        <div class="max-w-2xl">
                            <h2 class="text-3xl font-bold mb-2">Configuración</h2>
                            <p class="text-gray-500 mb-8">Personaliza tu experiencia en el panel.</p>

                            <!-- Theme Card -->
                            <div class="bg-white dark:bg-[#121214] rounded-2xl p-6 border border-gray-200 dark:border-zinc-800 mb-6">
                                <h3 class="font-bold text-lg mb-4">Apariencia</h3>
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="font-medium">Modo Oscuro</p>
                                        <p class="text-sm text-gray-500">Cambiar entre tema claro y oscuro.</p>
                                    </div>
                                    <button onclick="toggleTheme()" class="w-14 h-8 rounded-full bg-gray-200 dark:bg-zinc-700 relative transition-colors duration-300 focus:outline-none">
                                        <div id="theme-toggle-dot" class="w-6 h-6 bg-white rounded-full shadow-md absolute top-1 left-1 dark:translate-x-6 transition-transform duration-300 flex items-center justify-center">
                                            <i id="theme-icon" class="fa-solid fa-sun text-yellow-500 text-xs dark:hidden"></i>
                                            <i id="theme-icon-dark" class="fa-solid fa-moon text-indigo-500 text-xs hidden dark:block"></i>
                                        </div>
                                    </button>
                                </div>
                            </div>

                            <!-- Account Card -->
                            <div class="bg-white dark:bg-[#121214] rounded-2xl p-6 border border-gray-200 dark:border-zinc-800">
                                <h3 class="font-bold text-lg mb-4">Seguridad de la Cuenta</h3>
                                <form onsubmit="event.preventDefault(); alert('Función demo')" class="space-y-4">
                                    <div>
                                        <label class="block text-xs font-bold uppercase text-gray-500 mb-1">Nueva Contraseña</label>
                                        <input type="password" class="w-full bg-gray-50 dark:bg-zinc-900 border border-gray-200 dark:border-zinc-700 rounded-lg p-3 outline-none focus:border-black dark:focus:border-white transition-colors">
                                    </div>
                                    <button class="px-6 py-2 bg-black dark:bg-white text-white dark:text-black font-bold rounded-lg text-sm">
                                        Actualizar
                                    </button>
                                </form>
                            </div>
                        </div>
                    </section>

                    <!-- SECCIÓN: ADMIN (Solo visible si owner/admin) -->
                    <section id="tab-admin" class="tab-content hidden animate-fade-in-up">
                        <h2 class="text-3xl font-bold mb-8">Administración</h2>
                        <div class="bg-white dark:bg-[#121214] rounded-2xl border border-gray-200 dark:border-zinc-800 overflow-hidden">
                            <div class="overflow-x-auto">
                                <table class="w-full text-left text-sm">
                                    <thead class="bg-gray-50 dark:bg-zinc-900 border-b border-gray-200 dark:border-zinc-800">
                                        <tr>
                                            <th class="p-4 font-bold text-gray-500 uppercase text-xs">Usuario</th>
                                            <th class="p-4 font-bold text-gray-500 uppercase text-xs">Rol</th>
                                            <th class="p-4 font-bold text-gray-500 uppercase text-xs">Límite Bots</th>
                                            <th class="p-4 font-bold text-gray-500 uppercase text-xs text-right">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody id="admin-user-list" class="divide-y divide-gray-100 dark:divide-zinc-800 font-mono">
                                        <!-- Dynamic Content -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </section>

                </div>
                
                <footer class="text-center text-xs text-gray-400 py-6 border-t border-gray-200 dark:border-zinc-800 mt-auto">
                    <p>Hecho con <i class="fa-solid fa-heart text-red-500"></i> por <span class="font-bold text-gray-600 dark:text-gray-300">SoyMaycol</span></p>
                </footer>
            </div>
        </main>
    </div>

    <!-- MODAL: CONECTAR BOT -->
    <div id="link-modal" class="fixed inset-0 z-[60] hidden">
        <div class="absolute inset-0 bg-black/40 backdrop-blur-sm transition-opacity" onclick="closeModal('link-modal')"></div>
        <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-md p-4">
            <div class="bg-white dark:bg-[#18181b] rounded-2xl shadow-2xl overflow-hidden border border-gray-200 dark:border-zinc-700">
                <div class="p-6">
                    <div class="flex justify-between items-center mb-6">
                        <h3 class="text-xl font-bold">Vincular Dispositivo</h3>
                        <button onclick="closeModal('link-modal')" class="text-gray-400 hover:text-black dark:hover:text-white"><i class="fa-solid fa-times"></i></button>
                    </div>
                    
                    <div class="space-y-4">
                        <div>
                            <label class="block text-xs font-bold uppercase text-gray-500 mb-2">Número (con código país)</label>
                            <div class="relative">
                                <i class="fa-solid fa-phone absolute left-3 top-3.5 text-gray-400"></i>
                                <input type="number" id="phoneNumber" placeholder="51999999999" class="w-full pl-10 pr-4 py-3 bg-gray-50 dark:bg-zinc-900 border border-gray-200 dark:border-zinc-700 rounded-lg outline-none focus:ring-2 ring-black dark:ring-white transition-all font-mono">
                            </div>
                        </div>

                        <button onclick="requestCode()" id="btn-code" class="w-full py-3 bg-black dark:bg-white text-white dark:text-black font-bold rounded-lg hover:opacity-90 transition-opacity flex justify-center items-center gap-2">
                            <span>GENERAR CÓDIGO</span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>

                        <div id="code-area" class="hidden mt-6 text-center bg-gray-50 dark:bg-zinc-900 p-6 rounded-xl border border-dashed border-gray-300 dark:border-zinc-700">
                            <p class="text-xs text-gray-500 mb-2">Introduce este código en WhatsApp</p>
                            <h2 id="pairing-code" onclick="copyToClip(this.innerText)" class="text-3xl font-mono font-bold tracking-[0.2em] cursor-pointer select-all hover:text-green-500 transition-colors">---</h2>
                            <p id="timer" class="text-xs font-mono text-red-500 mt-2">--:--</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL: DETALLES DEL BOT -->
    <div id="detail-modal" class="fixed inset-0 z-[60] hidden">
        <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="closeModal('detail-modal')"></div>
        <div class="absolute right-0 top-0 h-full w-full max-w-md bg-white dark:bg-[#18181b] shadow-2xl border-l border-gray-200 dark:border-zinc-700 transform transition-transform duration-300 translate-x-0">
            <div class="h-full flex flex-col">
                <!-- Header -->
                <div class="p-6 border-b border-gray-200 dark:border-zinc-700 flex justify-between items-center bg-gray-50 dark:bg-zinc-900">
                    <div>
                        <h3 class="text-xl font-bold" id="modal-bot-name">Nombre Bot</h3>
                        <p class="text-xs font-mono text-gray-500" id="modal-bot-id">+00000</p>
                    </div>
                    <button onclick="closeModal('detail-modal')" class="w-8 h-8 rounded-full bg-white dark:bg-zinc-800 flex items-center justify-center shadow-sm hover:scale-110 transition-transform">
                        <i class="fa-solid fa-times"></i>
                    </button>
                </div>

                <!-- Body -->
                <div class="flex-1 overflow-y-auto p-6 space-y-6">
                    <!-- Status -->
                    <div class="flex items-center gap-3 p-4 bg-green-500/10 border border-green-500/20 rounded-xl">
                        <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
                        <span class="text-sm font-bold text-green-600 dark:text-green-400">Sistema Operativo y Conectado</span>
                    </div>

                    <!-- Actions -->
                    <div class="grid grid-cols-2 gap-3">
                        <button onclick="botAction('restart')" class="p-4 rounded-xl border border-gray-200 dark:border-zinc-700 hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-colors flex flex-col items-center gap-2 group">
                            <i class="fa-solid fa-arrows-rotate text-xl group-hover:rotate-180 transition-transform duration-500"></i>
                            <span class="text-xs font-bold uppercase">Reiniciar</span>
                        </button>
                        <button onclick="botAction('stop')" class="p-4 rounded-xl border border-red-200 dark:border-red-900/30 hover:bg-red-500 hover:text-white text-red-500 transition-colors flex flex-col items-center gap-2">
                            <i class="fa-solid fa-power-off text-xl"></i>
                            <span class="text-xs font-bold uppercase">Apagar</span>
                        </button>
                    </div>

                    <!-- Config Form -->
                    <div class="space-y-4 pt-4 border-t border-gray-200 dark:border-zinc-700">
                        <h4 class="font-bold text-sm uppercase text-gray-400">Personalización</h4>
                        <form id="config-form" class="space-y-4">
                            <div>
                                <label class="text-xs font-bold mb-1 block">Nombre Público</label>
                                <input type="text" id="conf-name" class="w-full p-3 bg-gray-50 dark:bg-zinc-900 border border-gray-200 dark:border-zinc-700 rounded-lg outline-none focus:border-black dark:focus:border-white text-sm">
                            </div>
                            <div>
                                <label class="text-xs font-bold mb-1 block">Imagen de Banner</label>
                                <div class="relative w-full h-32 bg-gray-100 dark:bg-zinc-900 rounded-lg border-2 border-dashed border-gray-300 dark:border-zinc-700 flex items-center justify-center group hover:border-black dark:hover:border-white transition-colors cursor-pointer overflow-hidden">
                                    <input type="file" id="conf-banner" class="absolute inset-0 opacity-0 cursor-pointer z-10" onchange="previewImage(this)">
                                    <div class="text-center text-gray-400 group-hover:text-gray-600 dark:group-hover:text-gray-200" id="upload-placeholder">
                                        <i class="fa-solid fa-cloud-arrow-up text-2xl mb-1"></i>
                                        <p class="text-xs">Click para subir</p>
                                    </div>
                                    <img id="preview-img" class="absolute inset-0 w-full h-full object-cover hidden">
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Footer -->
                <div class="p-6 border-t border-gray-200 dark:border-zinc-700 bg-gray-50 dark:bg-zinc-900">
                    <button onclick="saveBotConfig()" class="w-full py-3 bg-black dark:bg-white text-white dark:text-black font-bold rounded-xl hover:shadow-lg hover:-translate-y-1 transition-all">
                        GUARDAR CAMBIOS
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // --- THEME LOGIC ---
        const html = document.documentElement;
        const savedTheme = localStorage.getItem('theme');
        
        if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            html.classList.add('dark');
        } else {
            html.classList.remove('dark');
        }

        function toggleTheme() {
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            } else {
                html.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            }
        }

        // --- NAVIGATION LOGIC ---
        function switchTab(tabName) {
            // Hide all sections
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            // Show selected
            document.getElementById('tab-' + tabName).classList.remove('hidden');
            
            // Update Nav Styles
            document.querySelectorAll('.nav-item').forEach(el => {
                // Reset to default
                el.className = 'nav-item w-full flex items-center px-4 py-3 text-sm font-medium rounded-lg text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-zinc-800 transition-all group';
            });
            
            // Set Active Style
            const activeBtn = document.getElementById('nav-' + tabName);
            if(activeBtn) {
                activeBtn.className = 'nav-item w-full flex items-center px-4 py-3 text-sm font-medium rounded-lg bg-black text-white dark:bg-white dark:text-black shadow-lg transition-all group';
            }

            // Close sidebar on mobile
            if(window.innerWidth < 1024) toggleSidebar();

            // Load specific data
            if(tabName === 'admin') loadAdminUsers();
        }

        function toggleSidebar() {
            const sb = document.getElementById('sidebar');
            if (sb.classList.contains('-translate-x-full')) {
                sb.classList.remove('-translate-x-full');
            } else {
                sb.classList.add('-translate-x-full');
            }
        }

        // --- MODAL LOGIC ---
        function openLinkModal() {
            document.getElementById('link-modal').classList.remove('hidden');
        }
        
        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        // --- API & DATA ---
        let currentBotId = null;

        async function loadSystemStats() {
            try {
                const res = await fetch('/api/system-stats');
                const data = await res.json();
                document.getElementById('ram-usage').innerText = data.ram.usage;
                document.getElementById('uptime-stats').innerText = (data.uptime / 3600).toFixed(1) + 'h';
                document.getElementById('cpu-model').innerText = data.cpu.split(' ')[0]; // Simplify name
            } catch(e) {}
        }

        async function loadBots() {
            const grid = document.getElementById('bots-grid');
            try {
                const res = await fetch('/api/my-subbots');
                const bots = await res.json();
                
                document.getElementById('badge-count').innerText = bots.length;

                if (bots.length === 0) {
                    grid.innerHTML = `
                        <div class="col-span-full py-12 flex flex-col items-center text-center text-gray-400 border-2 border-dashed border-gray-200 dark:border-zinc-800 rounded-2xl">
                            <i class="fa-solid fa-robot text-4xl mb-4 opacity-50"></i>
                            <p>No tienes bots activos.</p>
                        </div>
                    `;
                    return;
                }

                grid.innerHTML = bots.map(bot => `
                    <div onclick="openBotDetail('${bot.id}', '${bot.name}', '${bot.localConfig?.banner || ''}')" class="group relative bg-white dark:bg-[#121214] rounded-2xl border border-gray-200 dark:border-zinc-800 overflow-hidden hover:shadow-xl transition-all duration-300 cursor-pointer hover:-translate-y-1">
                        <div class="h-24 bg-gray-100 dark:bg-zinc-800 relative">
                             ${bot.localConfig?.banner ? `<img src="${bot.localConfig.banner}" class="w-full h-full object-cover">` : '<div class="w-full h-full flex items-center justify-center opacity-10 pattern-grid-lg"></div>'}
                             <div class="absolute top-2 right-2 bg-green-500 text-white text-[10px] font-bold px-2 py-1 rounded-full shadow-sm">ONLINE</div>
                        </div>
                        <div class="p-5 relative">
                            <div class="w-12 h-12 bg-black dark:bg-white text-white dark:text-black rounded-xl absolute -top-6 left-5 flex items-center justify-center text-xl shadow-lg">
                                <i class="fa-solid fa-robot"></i>
                            </div>
                            <div class="mt-4 flex justify-between items-end">
                                <div>
                                    <h3 class="font-bold text-lg leading-tight group-hover:text-blue-500 transition-colors">${bot.name}</h3>
                                    <p class="text-xs font-mono text-gray-500 mt-1">+${bot.id}</p>
                                </div>
                                <button class="w-8 h-8 rounded-full bg-gray-100 dark:bg-zinc-800 flex items-center justify-center text-gray-500 group-hover:bg-black group-hover:text-white dark:group-hover:bg-white dark:group-hover:text-black transition-all">
                                    <i class="fa-solid fa-arrow-right -rotate-45 group-hover:rotate-0 transition-transform"></i>
                                </button>
                            </div>
                            <div class="mt-4 pt-4 border-t border-gray-100 dark:border-zinc-800 flex gap-4 text-xs font-mono text-gray-400">
                                <span><i class="fa-regular fa-paper-plane mr-1"></i> ${bot.stats?.messagesSent || 0} Msgs</span>
                            </div>
                        </div>
                    </div>
                `).join('');

            } catch (e) { console.error(e) }
        }

        async function requestCode() {
            const phone = document.getElementById('phoneNumber').value;
            const btn = document.getElementById('btn-code');
            const codeArea = document.getElementById('code-area');
            
            if(!phone) return Swal.fire('Error', 'Ingresa un número', 'warning');

            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i>';

            try {
                const res = await fetch('/request-code', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ phoneNumber: phone })
                });
                const data = await res.json();

                if(data.success) {
                    codeArea.classList.remove('hidden');
                    document.getElementById('pairing-code').innerText = data.code;
                    
                    let time = 60;
                    const interval = setInterval(() => {
                        document.getElementById('timer').innerText = `Expira en ${time}s`;
                        time--;
                        if(time < 0) { clearInterval(interval); codeArea.classList.add('hidden'); }
                    }, 1000);
                } else {
                    Swal.fire('Error', data.error, 'error');
                }
            } catch(e) { Swal.fire('Error', 'Fallo de conexión', 'error'); }
            
            btn.disabled = false;
            btn.innerHTML = '<span>GENERAR CÓDIGO</span><i class="fa-solid fa-arrow-right"></i>';
        }

        function openBotDetail(id, name, banner) {
            currentBotId = id;
            document.getElementById('modal-bot-name').innerText = name;
            document.getElementById('modal-bot-id').innerText = '+' + id;
            document.getElementById('conf-name').value = name;
            
            const prevImg = document.getElementById('preview-img');
            const placeH = document.getElementById('upload-placeholder');
            
            if(banner && banner !== 'undefined') {
                prevImg.src = banner;
                prevImg.classList.remove('hidden');
                placeH.classList.add('hidden');
            } else {
                prevImg.classList.add('hidden');
                placeH.classList.remove('hidden');
            }

            document.getElementById('detail-modal').classList.remove('hidden');
        }

        function previewImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('preview-img').src = e.target.result;
                    document.getElementById('preview-img').classList.remove('hidden');
                    document.getElementById('upload-placeholder').classList.add('hidden');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        async function botAction(action) {
            if(!currentBotId) return;
            const res = await fetch('/api/subbot/action', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ id: currentBotId, action })
            });
            const d = await res.json();
            if(d.success) {
                Swal.fire({icon: 'success', title: 'Comando enviado', toast: true, position: 'top-end', showConfirmButton: false, timer: 1500});
                loadBots();
                if(action === 'stop') closeModal('detail-modal');
            }
        }

        async function saveBotConfig() {
            const name = document.getElementById('conf-name').value;
            const banner = document.getElementById('conf-banner').files[0];
            const formData = new FormData();
            formData.append('botname', name);
            if(banner) formData.append('banner', banner);

            const res = await fetch(`/api/subbot/config/${currentBotId}`, { method: 'POST', body: formData });
            const d = await res.json();
            if(d.success) {
                Swal.fire({icon: 'success', title: 'Guardado', toast: true, position: 'top-end', showConfirmButton: false, timer: 1500});
                loadBots();
                closeModal('detail-modal');
            }
        }

        function copyToClip(text) {
            navigator.clipboard.writeText(text);
            Swal.fire({icon: 'success', title: 'Copiado', toast: true, position: 'top-end', showConfirmButton: false, timer: 1000});
        }

        async function loadAdminUsers() {
            const tbody = document.getElementById('admin-user-list');
            const res = await fetch('/api/admin/users');
            const users = await res.json();
            
            tbody.innerHTML = users.map(u => `
                <tr class="hover:bg-gray-50 dark:hover:bg-zinc-800/50 transition-colors">
                    <td class="p-4 font-bold text-sm">${u.username}</td>
                    <td class="p-4"><span class="bg-gray-200 dark:bg-zinc-800 px-2 py-1 rounded text-xs font-bold uppercase">${u.role}</span></td>
                    <td class="p-4 font-mono text-sm">${u.limit}</td>
                    <td class="p-4 text-right">
                        <button onclick="changeLimit('${u.username}')" class="text-xs font-bold border border-black dark:border-white px-3 py-1 hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black rounded-lg transition-colors">
                            EDITAR
                        </button>
                    </td>
                </tr>
            `).join('');
        }

        async function changeLimit(username) {
            const { value: limit } = await Swal.fire({
                title: 'Nuevo límite',
                input: 'number',
                background: document.documentElement.classList.contains('dark') ? '#18181b' : '#fff',
                color: document.documentElement.classList.contains('dark') ? '#fff' : '#000',
                showCancelButton: true
            });
            if (limit) {
                await fetch('/api/admin/users/limit', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ username, limit })
                });
                loadAdminUsers();
            }
        }

        // Init
        loadSystemStats();
        loadBots();
        setInterval(loadBots, 10000);
    </script>
</body>
</html>
